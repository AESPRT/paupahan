// Paupahan — Prisma schema
// Mirrors the PostgreSQL design from the implementation plan.
// Run `npx prisma migrate dev --name init` after setting DATABASE_URL in .env

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  landlord
  staff
  tenant
}

enum UnitStatus {
  vacant
  occupied
  maintenance
  reserved
}

enum LeaseStatus {
  active
  ended
  terminated
  pending
}

enum BillStatus {
  pending
  partial
  paid
  overdue
  void
}

enum NotificationChannel {
  email
  sms
  push
  in_app
}

enum NotificationStatus {
  pending
  sent
  failed
}

enum BookingStatus {
  requested
  confirmed
  cancelled
  completed
}

enum MaintenanceStatus {
  open
  in_progress
  resolved
  cancelled
}

enum MaintenancePriority {
  low
  medium
  high
  urgent
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String   @map("password_hash")
  fullName       String   @map("full_name")
  phone          String?
  role           UserRole @default(tenant)
  isActive       Boolean  @default(true) @map("is_active")
  emailVerified  Boolean  @default(false) @map("email_verified")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  properties        Property[]
  staffLinks        LandlordStaff[]     @relation("LandlordLinks")
  staffOf           LandlordStaff[]     @relation("StaffLinks")
  notifications     Notification[]
  analyticsSnapshots AnalyticsSnapshot[]
  auditLogs         AuditLog[]
  tenant            Tenant?

  @@map("users")
}

model LandlordStaff {
  id          String   @id @default(uuid())
  landlordId  String   @map("landlord_id")
  staffUserId String   @map("staff_user_id")
  permissions Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  landlord User @relation("LandlordLinks", fields: [landlordId], references: [id], onDelete: Cascade)
  staff    User @relation("StaffLinks", fields: [staffUserId], references: [id], onDelete: Cascade)

  @@unique([landlordId, staffUserId])
  @@map("landlord_staff")
}

model Property {
  id             String   @id @default(uuid())
  landlordId     String   @map("landlord_id")
  name           String
  addressLine    String   @map("address_line")
  city           String
  province       String?
  postalCode     String?  @map("postal_code")
  latitude       Decimal? @db.Decimal(10, 7)
  longitude      Decimal? @db.Decimal(10, 7)
  propertyType   String   @default("apartment") @map("property_type")
  amenities      Json     @default("[]")
  coverPhotoUrl  String?  @map("cover_photo_url")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  landlord           User                @relation(fields: [landlordId], references: [id], onDelete: Cascade)
  units              Unit[]
  analyticsSnapshots AnalyticsSnapshot[]

  @@map("properties")
}

model Unit {
  id            String     @id @default(uuid())
  propertyId    String     @map("property_id")
  unitNumber    String     @map("unit_number")
  floor         String?
  unitType      String?    @map("unit_type")
  monthlyRent   Decimal    @map("monthly_rent") @db.Decimal(12, 2)
  maxOccupants  Int        @default(1) @map("max_occupants")
  status        UnitStatus @default(vacant)
  amenities     Json       @default("[]")
  photos        Json       @default("[]")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  property             Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  leases               Lease[]
  bookings             Booking[]
  maintenanceRequests  MaintenanceRequest[]

  @@unique([propertyId, unitNumber])
  @@index([propertyId, status])
  @@map("units")
}

model Tenant {
  id                String   @id @default(uuid())
  userId            String?  @unique @map("user_id")
  fullName          String   @map("full_name")
  email             String?
  phone             String
  idNumber          String?  @map("id_number")
  emergencyContact  Json?    @map("emergency_contact")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user                 User?                 @relation(fields: [userId], references: [id])
  leases               Lease[]
  bills                Bill[]
  payments             Payment[]
  maintenanceRequests  MaintenanceRequest[]

  @@map("tenants")
}

model Lease {
  id             String      @id @default(uuid())
  tenantId       String      @map("tenant_id")
  unitId         String      @map("unit_id")
  startDate      DateTime    @map("start_date") @db.Date
  endDate        DateTime?   @map("end_date") @db.Date
  monthlyRent    Decimal     @map("monthly_rent") @db.Decimal(12, 2)
  depositAmount  Decimal     @default(0) @map("deposit_amount") @db.Decimal(12, 2)
  billingDay     Int         @default(1) @map("billing_day")
  status         LeaseStatus @default(active)
  utilityConfig  Json        @default("{}") @map("utility_config")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit   Unit   @relation(fields: [unitId], references: [id])
  bills  Bill[]

  @@index([tenantId])
  @@index([unitId, status])
  @@map("leases")
}

model Bill {
  id             String     @id @default(uuid())
  leaseId        String     @map("lease_id")
  tenantId       String     @map("tenant_id")
  billingPeriod  DateTime   @map("billing_period") @db.Date
  dueDate        DateTime   @map("due_date") @db.Date
  subtotal       Decimal    @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal    @default(0) @map("total_amount") @db.Decimal(12, 2)
  amountPaid     Decimal    @default(0) @map("amount_paid") @db.Decimal(12, 2)
  status         BillStatus @default(pending)
  generatedAt    DateTime   @default(now()) @map("generated_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  lease    Lease       @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items    BillItem[]
  payments Payment[]

  @@unique([leaseId, billingPeriod])
  @@index([status, dueDate])
  @@index([tenantId])
  @@map("bills")
}

model BillItem {
  id          String  @id @default(uuid())
  billId      String  @map("bill_id")
  itemType    String  @map("item_type")
  description String?
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@map("bill_items")
}

model Payment {
  id             String   @id @default(uuid())
  billId         String   @map("bill_id")
  tenantId       String   @map("tenant_id")
  amount         Decimal  @db.Decimal(12, 2)
  paymentMethod  String   @map("payment_method")
  referenceNo    String?  @map("reference_no")
  paidAt         DateTime @default(now()) @map("paid_at")
  recordedBy     String?  @map("recorded_by")
  createdAt      DateTime @default(now()) @map("created_at")

  bill   Bill   @relation(fields: [billId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([billId])
  @@index([tenantId])
  @@map("payments")
}

model NotificationTemplate {
  id      String  @id @default(uuid())
  type    String  @unique
  subject String?
  body    String

  @@map("notification_templates")
}

model Notification {
  id                 String               @id @default(uuid())
  recipientUserId    String?              @map("recipient_user_id")
  type               String
  channel            NotificationChannel
  title              String?
  message            String
  relatedEntityType  String?              @map("related_entity_type")
  relatedEntityId    String?              @map("related_entity_id")
  status             NotificationStatus   @default(pending)
  sentAt             DateTime?            @map("sent_at")
  createdAt          DateTime             @default(now()) @map("created_at")

  recipient User? @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, status])
  @@map("notifications")
}

model Booking {
  id             String        @id @default(uuid())
  unitId         String        @map("unit_id")
  prospectName   String        @map("prospect_name")
  prospectEmail  String?       @map("prospect_email")
  prospectPhone  String        @map("prospect_phone")
  requestedAt    DateTime      @map("requested_at")
  status         BookingStatus @default(requested)
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at")

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId, status])
  @@map("bookings")
}

model MaintenanceRequest {
  id          String              @id @default(uuid())
  unitId      String              @map("unit_id")
  tenantId    String?             @map("tenant_id")
  category    String
  description String
  priority    MaintenancePriority @default(medium)
  status      MaintenanceStatus   @default(open)
  photos      Json                @default("[]")
  createdAt   DateTime            @default(now()) @map("created_at")
  resolvedAt  DateTime?           @map("resolved_at")

  unit   Unit    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@map("maintenance_requests")
}

model AnalyticsSnapshot {
  id                 String   @id @default(uuid())
  landlordId         String   @map("landlord_id")
  propertyId         String?  @map("property_id")
  period             DateTime @db.Date
  totalUnits         Int      @default(0) @map("total_units")
  occupiedUnits      Int      @default(0) @map("occupied_units")
  occupancyRate      Decimal  @default(0) @map("occupancy_rate") @db.Decimal(5, 2)
  totalBilled        Decimal  @default(0) @map("total_billed") @db.Decimal(14, 2)
  totalCollected     Decimal  @default(0) @map("total_collected") @db.Decimal(14, 2)
  totalOutstanding   Decimal  @default(0) @map("total_outstanding") @db.Decimal(14, 2)
  collectionRate     Decimal  @default(0) @map("collection_rate") @db.Decimal(5, 2)
  generatedAt        DateTime @default(now()) @map("generated_at")

  landlord User      @relation(fields: [landlordId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([landlordId, propertyId, period])
  @@map("analytics_snapshots")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id])

  @@map("audit_logs")
}
