// Paupahan — Prisma schema
// Aligned with frontend/backend TypeScript types

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  landlord
  staff
  tenant
}

enum RoomStatus {
  vacant
  occupied
  reserved
  maintenance
}

enum LeaseStatus {
  active
  pending
  moving_out
  inactive
}

enum BillStatus {
  draft
  pending
  payment_submitted
  paid
  overdue
}

enum NotificationChannel {
  email
  sms
  push
  in_app
}

enum NotificationStatus {
  pending
  sent
  failed
}

enum MaintenancePriority {
  low
  medium
  high
  emergency
}

enum MaintenanceStatus {
  pending
  in_progress
  resolved
  rejected
}

enum MaintenanceCategory {
  plumbing
  electrical
  appliance
  structural
  others
}

enum UtilityType {
  electricity
  water
  other
  amenities
}

enum PlanTier {
  panimula
  bahay_upa
  maalam
  negosyante
  custom
}

enum SubscriptionStatus {
  active
  past_due
  trialing
  canceled
}

enum BillItemStatus {
  pending
  approved
  rejected
}

enum UnitStatus {
  vacant
  occupied
  reserved
}

enum PaymentStatus {
  paid
  overdue
  pending
  draft

  @@map("payment_status")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String   @map("password_hash")
  fullName      String   @map("full_name")
  phone         String?
  role          UserRole @default(tenant)
  avatarUrl     String?  @map("avatar_url")
  isActive      Boolean  @default(true) @map("is_active")
  emailVerified Boolean  @default(false) @map("email_verified")

  paymentSettings      Json? @map("payment_settings")
  notificationSettings Json? @map("notification_settings")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  properties         Property[]
  staffLinks         LandlordStaff[]     @relation("LandlordLinks")
  staffOf            LandlordStaff[]     @relation("StaffLinks")
  notifications      Notification[]
  analyticsSnapshots AnalyticsSnapshot[]
  auditLogs          AuditLog[]
  tenants            Tenant[]
  subscription       Subscription?

  @@map("users")
}

model LandlordStaff {
  id          String   @id @default(uuid())
  landlordId  String   @map("landlord_id")
  staffUserId String   @map("staff_user_id")
  permissions Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  landlord User @relation("LandlordLinks", fields: [landlordId], references: [id], onDelete: Cascade)
  staff    User @relation("StaffLinks", fields: [staffUserId], references: [id], onDelete: Cascade)

  @@unique([landlordId, staffUserId])
  @@map("landlord_staff")
}

model Property {
  id               String   @id @default(uuid())
  landlordId       String   @map("landlord_id")
  name             String
  addressLine      String   @map("address_line")
  city             String
  province         String?
  postalCode       String?  @map("postal_code")
  propertySettings Json?    @map("property_settings")
  coverPhotoUrl    String?  @map("cover_photo_url")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  landlord           User                @relation(fields: [landlordId], references: [id], onDelete: Cascade)
  units              Unit[] // Mga Building / Floor / Section
  analyticsSnapshots AnalyticsSnapshot[]
  amenities          Amenity[]

  @@map("properties")
}

model Unit {
  id          String     @id @default(uuid())
  propertyId  String     @map("property_id")
  monthlyRent Decimal?   @map("monthly_rent") @db.Decimal(12, 2)
  name        String     // Halimbawa: "Building A" o "2nd Floor"
  description String?
  status      UnitStatus @default(vacant)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  property            Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rooms               Room[]               // Mga kuwarto/pintuan sa loob ng unit na ito
  leases              Lease[]
  maintenanceRequests MaintenanceRequest[]

  @@map("units")
}

model Room {
  id           String     @id @default(uuid())
  unitId       String     @map("unit_id")
  roomNumber   String     @map("room_number")
  status       RoomStatus @default(vacant)
  monthlyRent  Decimal    @map("monthly_rent") @db.Decimal(12, 2)
  maxOccupants Int        @default(1) @map("max_occupants")
  amenities    Json       @default("[]")
  photos       Json       @default("[]")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  unit                Unit                 @relation(fields: [unitId], references: [id], onDelete: Cascade)
  leases              Lease[]
  maintenanceRequests MaintenanceRequest[]

  @@unique([unitId, roomNumber])
  @@index([unitId, status])
  @@map("rooms")
}

model Tenant {
  id                    String   @id @default(uuid())
  userId                String?  @map("user_id")
  loginCode             String   @unique @map("login_code")
  fullName              String   @map("full_name")
  email                 String?
  phone                 String?
  emergencyContactName  String?  @map("emergency_contact_name")
  emergencyContactPhone String?  @map("emergency_contact_phone")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user                User?                @relation(fields: [userId], references: [id])
  leases              Lease[]
  bills               Bill[]
  payments            Payment[]
  maintenanceRequests MaintenanceRequest[]

  @@map("tenants")
}

model Lease {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  unitId      String?   @map("unit_id") // 👈 Unit-level lease (optional)
  roomId      String?   @map("room_id") // 👈 Room-level lease (optional)
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  monthlyRent Decimal   @map("monthly_rent") @db.Decimal(12, 2)

  advanceMonths Decimal @default(1) @map("advance_months") @db.Decimal(4, 2)
  advanceAmount Decimal @default(0) @map("advance_amount") @db.Decimal(12, 2)
  depositMonths Decimal @default(1) @map("deposit_months") @db.Decimal(4, 2)
  depositAmount Decimal @default(0) @map("deposit_amount") @db.Decimal(12, 2)

  status        LeaseStatus @default(active)
  paymentStatus PaymentStatus @default(pending) @map("payment_status")
  utilityConfig Json        @default("{}") @map("utility_config")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit      Unit?          @relation(fields: [unitId], references: [id]) // 👈 Idagdag ito para sa Opposite Relation
  room      Room?          @relation(fields: [roomId], references: [id]) // 👈 Ginawa ring optional
  bills     Bill[]
  amenities LeaseAmenity[]

  @@index([tenantId])
  @@index([unitId, status])
  @@index([roomId, status])
  @@map("leases")
}

model Bill {
  id                String     @id @default(uuid())
  leaseId           String     @map("lease_id")
  tenantId          String     @map("tenant_id")
  billingMonthYear  String     @map("billing_month_year")
  dueDate           DateTime   @map("due_date") @db.Date
  rentAmount        Decimal    @default(0) @map("rent_amount") @db.Decimal(12, 2)
  amenitiesFee      Decimal    @default(0) @map("amenities_fee") @db.Decimal(12, 2)
  utilityAmount     Decimal    @default(0) @map("utility_amount") @db.Decimal(12, 2) // 👈 Idinagdag para sa kabuuang utility sa bill
  totalAmount       Decimal    @default(0) @map("total_amount") @db.Decimal(12, 2)
  status            BillStatus @default(draft)
  paymentReceiptUrl String?    @map("payment_receipt_url")
  paidAt            DateTime?  @map("paid_at")
  generatedAt       DateTime   @default(now()) @map("generated_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  metadata          Json       @default("{}") // 👈 Idinagdag para suportahan ang utilityType metadata

  lease    Lease      @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items    BillItem[]
  payments Payment[]

  @@unique([leaseId, billingMonthYear])
  @@index([status, dueDate])
  @@index([tenantId])
  @@map("bills")
}

model BillItem {
  id              String         @id @default(uuid())
  billId          String         @map("bill_id")
  type            UtilityType
  previousReading Decimal?       @map("previous_reading") @db.Decimal(10, 2)
  currentReading  Decimal?       @map("current_reading") @db.Decimal(10, 2)
  ratePerUnit     Decimal        @map("rate_per_unit") @db.Decimal(12, 2)
  unitLabel       String         @map("unit_label")
  proofPhotoUrl   String?        @map("proof_photo_url")
  amount          Decimal        @db.Decimal(12, 2)
  status          BillItemStatus @default(pending)

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@map("bill_items")
}

// 👈 Bagong Model para sa Utility Rates
model UtilityRate {
  id          String      @id @default(uuid())
  type        UtilityType @unique
  name        String
  ratePerUnit Decimal     @map("rate_per_unit") @db.Decimal(12, 2)
  unitLabel   String      @map("unit_label")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@map("utility_rates")
}

model Payment {
  id            String   @id @default(uuid())
  billId        String   @map("bill_id")
  tenantId      String   @map("tenant_id")
  amount        Decimal  @db.Decimal(12, 2)
  paymentMethod String   @map("payment_method")
  referenceNo   String?  @map("reference_no")
  paidAt        DateTime @default(now()) @map("paid_at")
  createdAt     DateTime @default(now()) @map("created_at")

  bill   Bill   @relation(fields: [billId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([billId])
  @@index([tenantId])
  @@map("payments")
}

model MaintenanceRequest {
  id           String              @id @default(uuid())
  ticketNumber String?             @map("ticket_number")
  roomId       String?             @map("room_id") // Ginawang opsyonal (?)
  unitId       String?             @map("unit_id") // Ginawang opsyonal (?)
  tenantId     String?             @map("tenant_id")
  title        String
  category     MaintenanceCategory
  description  String
  priority     MaintenancePriority @default(medium)
  status       MaintenanceStatus   @default(pending)
  photoUrl     String?             @map("photo_url")
  adminRemark  String?             @map("admin_remark")
  expenses     Float?              @default(0.0)
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  room   Room?   @relation(fields: [roomId], references: [id], onDelete: Cascade) // Opsyonal na relasyon
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: Cascade) // Opsyonal na relasyon
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@map("maintenance_requests")
}

model AnalyticsSnapshot {
  id               String   @id @default(uuid())
  landlordId       String   @map("landlord_id")
  propertyId       String?  @map("property_id")
  period           DateTime @db.Date
  totalUnits       Int      @default(0) @map("total_units")
  occupiedUnits    Int      @default(0) @map("occupied_units")
  occupancyRate    Decimal  @default(0) @map("occupancy_rate") @db.Decimal(5, 2)
  totalBilled      Decimal  @default(0) @map("total_billed") @db.Decimal(14, 2)
  totalCollected   Decimal  @default(0) @map("total_collected") @db.Decimal(14, 2)
  totalOutstanding Decimal  @default(0) @map("total_outstanding") @db.Decimal(14, 2)
  collectionRate   Decimal  @default(0) @map("collection_rate") @db.Decimal(5, 2)
  generatedAt      DateTime @default(now()) @map("generated_at")

  landlord User      @relation(fields: [landlordId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([landlordId, propertyId, period])
  @@map("analytics_snapshots")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id])

  @@map("audit_logs")
}

model Subscription {
  id              String             @id @default(uuid())
  landlordId      String             @unique @map("landlord_id")
  planTier        PlanTier           @default(panimula) @map("plan_tier")
  status          SubscriptionStatus @default(trialing)
  renewsOn        DateTime?          @map("renews_on")
  paymentMethod   String?            @map("payment_method") // Halimbawa: "gcash" o "card"
  paymentNumber   String?            @map("payment_number") // Para sa GCash number o Card details
  paymentMethodId String?            @map("payment_method_id") // ID mula sa PayMongo
  autoRenew       Boolean            @default(true) @map("auto_renew")
  maxUnitsLimit   Int                @default(1) @map("max_units_limit")
  maxRoomLimit    Int                @default(3) @map("max_room_limit")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  landlord User @relation(fields: [landlordId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Notification {
  id                String              @id @default(uuid())
  recipientUserId   String?             @map("recipient_user_id")
  type              String
  channel           NotificationChannel
  title             String?
  message           String
  relatedEntityType String?             @map("related_entity_type")
  relatedEntityId   String?             @map("related_entity_id")
  status            NotificationStatus  @default(pending)
  sentAt            DateTime?           @map("sent_at")
  createdAt         DateTime            @default(now()) @map("created_at")

  recipient User? @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, status])
  @@map("notifications")
}

model Amenity {
  id          String   @id @default(uuid())
  propertyId  String?  @map("property_id")
  name        String // hal. "Parking Space", "Aircon Fee", "Pet Fee"
  amount      Decimal  @db.Decimal(12, 2)
  frequency   String   @default("Buwanan") // "Buwanan", "Isang beses", atbp.
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  property   Property?      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  leaseItems LeaseAmenity[]

  @@map("amenities")
}

model LeaseAmenity {
  id        String   @id @default(uuid())
  leaseId   String   @map("lease_id")
  amenityId String   @map("amenity_id")
  quantity  Int      @default(1)
  amount    Decimal  @db.Decimal(12, 2) // Na-override o snapshot amount
  createdAt DateTime @default(now()) @map("created_at")

  lease   Lease   @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([leaseId, amenityId])
  @@map("lease_amenities")
}
